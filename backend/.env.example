# FixLink backend environment template. Copy to .env and replace all development values.
# Never commit .env.
NODE_ENV=development

# Database (MySQL 8, see docker-compose.yml — host port 3307):
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=fixlink
DB_PASSWORD=fixlink_dev_password
DB_NAME=fixlink

# Auth:
# - JWT_ACCESS_SECRET must be a long random value in production.
# - AUTH_STORE=memory runs without MySQL (used by automated tests).
#   AUTH_STORE=mysql (default) uses the MySQL users/roles/user_roles tables.
AUTH_STORE=mysql
JWT_ACCESS_SECRET=dev-only-change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
BCRYPT_COST=12

# Server:
PORT=3000
CORS_ORIGIN=http://localhost:4200
FILE_STORAGE_DIR=./uploads
