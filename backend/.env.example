# Fixlynk backend environment template. Copy to .env and replace all development values.
# Never commit .env.
NODE_ENV=development

# Database (MySQL 8, see docker-compose.yml — host port 3307):
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=fixlynk
DB_PASSWORD=fixlynk_dev_password
DB_NAME=fixlynk

# Auth:
# - JWT_ACCESS_SECRET must be a long random value in production.
# - AUTH_STORE=memory runs without MySQL (used by automated tests).
#   AUTH_STORE=mysql (default) uses the MySQL users/roles/user_roles tables.
AUTH_STORE=mysql
JWT_ACCESS_SECRET=dev-only-change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
BCRYPT_COST=12

# Server:
PORT=3000
CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200
FILE_STORAGE_DIR=./uploads

# Web app (used for the "view and reply" link in provider notification email):
WEB_BASE_URL=http://localhost:4200

# Provider notification email (docs/NOTIFICATIONS.md).
# Leave MAIL_ENABLED=false locally: provider notifications stay in-app and the
# rendered email is only written to the log, so no mail server is needed.
# Set MAIL_ENABLED=true AND MAIL_HOST to deliver for real.
MAIL_ENABLED=false
# MAIL_HOST=smtp.example.co.za
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=
# MAIL_PASSWORD=
MAIL_FROM=no-reply@example.co.za
MAIL_FROM_NAME=Fixlynk

# Operations inbox for platform alerts (new registration, new job posted).
# Leave empty to disable these emails entirely.
OPS_ALERT_EMAIL=info@fixlynk.co.za
