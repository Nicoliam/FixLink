# Fixlynk web root (.htaccess)
#
# Put this file in the same directory as the Angular index.html — that is the
# directory Apache serves for fixlynk.co.za (usually public_html).
#
# It does two things:
#   1. SPA fallback, so a direct visit or refresh on a client route such as
#      /my-jobs or /business/jobs serves index.html instead of a 404.
#   2. Nothing else. The API is a separate Node.js application; see the API
#      section below and enable it only if your host supports mod_proxy.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Never rewrite a real file (hashed assets, images, favicon, robots.txt).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is an Angular client route.
  RewriteRule . /index.html [L]
</IfModule>

# Long-lived caching for the hashed build output. index.html is never cached.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|svg|png|jpg|jpeg|webp|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# API: only if your host allows mod_proxy and you want a same-origin /api.
#
# The Angular production build calls /api/v1 on its own origin, so without a
# proxy the requests must go to the Node.js application directly (cPanel shows
# its port, e.g. https://fixlynk.co.za:3000). In that case ignore this block
# and set the API URL at build time instead.
#
# Replace 3000 with the port cPanel assigns to the application, and enable
# mod_proxy in cPanel > Select PHP Version > extensions if it is available.
#
# <IfModule mod_proxy.c>
#   RewriteEngine On
#   RewriteRule ^api/(.*)$ http://127.0.0.1:3000/api/$1 [P,L]
# </IfModule>
# ---------------------------------------------------------------------------
