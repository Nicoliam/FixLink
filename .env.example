NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200
AUTH_STORE=mysql

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=fixlynk
DB_USER=fixlynk
DB_PASSWORD=fixlynk_dev_password

JWT_ACCESS_SECRET=dev-only-change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
BCRYPT_COST=12
FILE_STORAGE_DIR=./uploads

# Web app origin used for provider notification email deep links:
WEB_BASE_URL=http://localhost:4200

# Provider notification email — off by default; see docs/NOTIFICATIONS.md.
MAIL_ENABLED=false
# MAIL_HOST=smtp.example.co.za
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=
# MAIL_PASSWORD=
MAIL_FROM=no-reply@example.co.za
MAIL_FROM_NAME=Fixlynk
